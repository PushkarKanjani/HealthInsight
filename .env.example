# HealthInsight Environment Variables
# Copy this file to .env and fill in your values.

# ==============================================================================
# v1 LAKEHOUSE — Infrastructure
# ==============================================================================
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.20.101-hotspot
HADOOP_HOME=C:\hadoop

# Data and warehouse paths
DATA_DIR=data/raw
ICEBERG_WAREHOUSE=file:/warehouse

# Trino connection
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=healthcare

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=healthinsight

# Spark package coordinates (do not change without updating pipeline scripts)
ICEBERG_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-3.5_2.12:1.5.2
MONGO_PACKAGE=org.mongodb.spark:mongo-spark-connector_2.12:10.3.0

# ==============================================================================
# v2 AI PORTAL — Secrets
# ==============================================================================

# JWT secret key — change this to a strong random value before any shared use
PORTAL_JWT_SECRET=healthinsight_jwt_secret_change_me_2026

# Google Gemini API Key (optional — portal uses offline fallback if not set)
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
