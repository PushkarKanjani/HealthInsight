# HealthInsight Environment Variables
# Copy this file to .env and fill in your absolute paths.
# NEVER commit .env to git.

# Dataset
DATA_DIR=/absolute/path/to/HealthInsight/data/raw

# Iceberg
ICEBERG_WAREHOUSE=/absolute/path/to/HealthInsight/iceberg/warehouse

# JARs (update filenames to match your downloaded versions)
ICEBERG_JAR=/absolute/path/to/HealthInsight/lib/iceberg-spark-runtime-3.5_2.12-1.5.x.jar
MONGO_JAR=/absolute/path/to/HealthInsight/lib/mongo-spark-connector_2.12-10.x.x.jar

# Trino
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=healthcare

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=healthinsight

# Spark
SPARK_HOME=/path/to/spark-3.5.x-bin-hadoop3
JAVA_HOME=/path/to/java17
